{
    "name": "karelwintersky/arris.config",
    "description": "Arris µFramework: read-only config reader and AppConfig",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Karel Wintersky",
            "email": "karel.wintersky@gmail.com"
        }
    ],
    "keywords": [ "arris", "config" ],
    "config": {
        "optimize-autoloader": true,
        "platform-check": false,
        "sort-packages": true
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "internal/toml": "^1.1",
        "phpunit/phpunit": "^10",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0"
    },
    "suggest": {
        "karelwintersky/arris": "Karel Wintersky's Application µFramework",
        "internal/toml": "Required to read TOML configs",
        "symfony/yaml": "Required to read YAML configs"
    },
    "autoload": {
        "psr-4": {
            "Arris\\": "sources"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    }
}
